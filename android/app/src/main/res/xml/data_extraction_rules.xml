<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ replacement for allowBackup/fullBackupContent. Both cloud
     backup and device-to-device transfer are fully disabled: the vault's
     master key lives in the Android Keystore and cannot move with the
     data, so any transferred copy would be undecryptable. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
